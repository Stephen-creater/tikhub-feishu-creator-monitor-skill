{
  "base_name": "TikHub 自媒体竞品监控系统（Skill 版）",
  "time_zone": "Asia/Shanghai",
  "tables": [
    {
      "name": "账号库",
      "fields": [
        {"type": "text", "name": "账号键", "description": "platform:account_id，外部业务主键"},
        {"type": "select", "name": "平台", "multiple": false, "options": [{"name": "抖音", "hue": "Blue"}, {"name": "小红书", "hue": "Red"}]},
        {"type": "text", "name": "账号ID"},
        {"type": "text", "name": "昵称"},
        {"type": "text", "name": "账号主页", "style": {"type": "url"}},
        {"type": "attachment", "name": "头像"},
        {"type": "text", "name": "头像原始链接", "style": {"type": "url"}},
        {"type": "text", "name": "简介"},
        {"type": "number", "name": "粉丝数", "style": {"type": "plain", "precision": 0, "thousands_separator": true}},
        {"type": "number", "name": "粉丝增量", "style": {"type": "plain", "precision": 0, "thousands_separator": true}},
        {"type": "number", "name": "关注数", "style": {"type": "plain", "precision": 0, "thousands_separator": true}},
        {"type": "number", "name": "作品数", "style": {"type": "plain", "precision": 0, "thousands_separator": true}},
        {"type": "number", "name": "总获赞数", "style": {"type": "plain", "precision": 0, "thousands_separator": true}},
        {"type": "checkbox", "name": "启用监控"},
        {"type": "number", "name": "抓取频率小时", "default_value": 6},
        {"type": "select", "name": "监控状态", "multiple": false, "options": [{"name": "正常", "hue": "Green"}, {"name": "暂停", "hue": "Gray"}, {"name": "异常", "hue": "Red"}]},
        {"type": "datetime", "name": "首次发现时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "datetime", "name": "最后抓取时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "datetime", "name": "最近成功时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "datetime", "name": "下次抓取时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "text", "name": "数据哈希"},
        {"type": "text", "name": "最后错误"}
      ]
    },
    {
      "name": "内容库",
      "fields": [
        {"type": "text", "name": "内容键", "description": "platform:content_id，外部业务主键"},
        {"type": "select", "name": "平台", "multiple": false, "options": [{"name": "抖音", "hue": "Blue"}, {"name": "小红书", "hue": "Red"}]},
        {"type": "text", "name": "内容ID"},
        {"type": "text", "name": "账号键"},
        {"type": "text", "name": "账号昵称"},
        {"type": "text", "name": "标题"},
        {"type": "text", "name": "正文摘要"},
        {"type": "text", "name": "内容链接", "style": {"type": "url"}},
        {"type": "attachment", "name": "封面"},
        {"type": "text", "name": "封面原始链接", "style": {"type": "url"}},
        {"type": "text", "name": "媒体原始链接", "style": {"type": "url"}},
        {"type": "attachment", "name": "媒体附件"},
        {"type": "datetime", "name": "发布时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "number", "name": "时长秒", "style": {"type": "plain", "precision": 1}},
        {"type": "number", "name": "播放数", "style": {"type": "plain", "precision": 0, "thousands_separator": true}},
        {"type": "number", "name": "点赞数", "style": {"type": "plain", "precision": 0, "thousands_separator": true}},
        {"type": "number", "name": "收藏数", "style": {"type": "plain", "precision": 0, "thousands_separator": true}},
        {"type": "number", "name": "评论数", "style": {"type": "plain", "precision": 0, "thousands_separator": true}},
        {"type": "number", "name": "分享数", "style": {"type": "plain", "precision": 0, "thousands_separator": true}},
        {"type": "number", "name": "旧播放数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "旧点赞数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "旧收藏数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "旧评论数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "旧分享数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "播放增量", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "点赞增量", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "收藏增量", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "评论增量", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "分享增量", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "收藏率", "style": {"type": "plain", "precision": 4, "percentage": true}},
        {"type": "number", "name": "爆款指数", "style": {"type": "plain", "precision": 2}},
        {"type": "select", "name": "爆款等级", "multiple": false, "options": [{"name": "S", "hue": "Red", "lightness": "Standard"}, {"name": "A", "hue": "Orange"}, {"name": "B", "hue": "Blue"}, {"name": "C", "hue": "Gray"}]},
        {"type": "checkbox", "name": "近60天"},
        {"type": "checkbox", "name": "已阅"},
        {"type": "select", "name": "跟进状态", "multiple": false, "options": [{"name": "待处理", "hue": "Blue"}, {"name": "待拆解", "hue": "Purple"}, {"name": "拆解中", "hue": "Orange"}, {"name": "已建档", "hue": "Green"}, {"name": "待翻拍", "hue": "Carmine"}, {"name": "拍摄中", "hue": "Yellow"}, {"name": "已完成", "hue": "Green", "lightness": "Dark"}, {"name": "忽略", "hue": "Gray"}]},
        {"type": "select", "name": "拆解状态", "multiple": false, "options": [{"name": "未拆解", "hue": "Gray"}, {"name": "待拆解", "hue": "Purple"}, {"name": "拆解中", "hue": "Orange"}, {"name": "已建档", "hue": "Green"}, {"name": "拆解失败", "hue": "Red"}]},
        {"type": "text", "name": "拆解文档", "style": {"type": "url"}},
        {"type": "text", "name": "ASR文案"},
        {"type": "text", "name": "跟进建议"},
        {"type": "datetime", "name": "首次发现时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "datetime", "name": "最后抓取时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "text", "name": "数据哈希"}
      ]
    },
    {
      "name": "指标快照",
      "fields": [
        {"type": "text", "name": "快照键"},
        {"type": "select", "name": "对象类型", "multiple": false, "options": [{"name": "账号"}, {"name": "内容"}]},
        {"type": "text", "name": "对象键"},
        {"type": "datetime", "name": "时间桶", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "datetime", "name": "采集时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "number", "name": "粉丝数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "播放数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "点赞数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "收藏数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "评论数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "分享数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "粉丝增量", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "播放增量", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "点赞增量", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "收藏增量", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "评论增量", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "分享增量", "style": {"type": "plain", "precision": 0}},
        {"type": "text", "name": "运行ID"}
      ]
    },
    {
      "name": "评论库",
      "fields": [
        {"type": "text", "name": "评论键"},
        {"type": "select", "name": "平台", "multiple": false, "options": [{"name": "抖音", "hue": "Blue"}, {"name": "小红书", "hue": "Red"}]},
        {"type": "text", "name": "评论ID"},
        {"type": "text", "name": "内容键"},
        {"type": "text", "name": "父评论ID"},
        {"type": "text", "name": "评论内容"},
        {"type": "datetime", "name": "发布时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "number", "name": "点赞数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "回复数", "style": {"type": "plain", "precision": 0}},
        {"type": "text", "name": "匿名作者ID"},
        {"type": "select", "name": "情绪", "multiple": false, "options": [{"name": "正向", "hue": "Green"}, {"name": "中性", "hue": "Gray"}, {"name": "负向", "hue": "Red"}]},
        {"type": "select", "name": "意图", "multiple": true, "options": [{"name": "提问"}, {"name": "求教程"}, {"name": "购买意向"}, {"name": "吐槽"}, {"name": "建议"}, {"name": "其他"}]},
        {"type": "text", "name": "主题"},
        {"type": "datetime", "name": "采集时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "text", "name": "数据哈希"}
      ]
    },
    {
      "name": "运行日志",
      "fields": [
        {"type": "text", "name": "运行ID"},
        {"type": "text", "name": "任务名称"},
        {"type": "select", "name": "状态", "multiple": false, "options": [{"name": "running", "hue": "Blue"}, {"name": "success", "hue": "Green"}, {"name": "partial", "hue": "Orange"}, {"name": "failed", "hue": "Red"}, {"name": "skipped_overlap", "hue": "Gray"}]},
        {"type": "datetime", "name": "计划时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "datetime", "name": "开始时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "datetime", "name": "结束时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "text", "name": "平台"},
        {"type": "number", "name": "抓取数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "批内去重数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "新增数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "更新数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "未变化数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "失败数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "TikHub请求数", "style": {"type": "plain", "precision": 0}},
        {"type": "number", "name": "TikHub费用USD", "style": {"type": "currency", "precision": 4, "currency_code": "USD"}},
        {"type": "text", "name": "错误类型"},
        {"type": "text", "name": "错误摘要"},
        {"type": "text", "name": "代码版本"},
        {"type": "text", "name": "Schema版本"}
      ]
    },
    {
      "name": "失败队列",
      "fields": [
        {"type": "text", "name": "失败键"},
        {"type": "text", "name": "运行ID"},
        {"type": "text", "name": "对象键"},
        {"type": "text", "name": "失败阶段"},
        {"type": "text", "name": "错误类型"},
        {"type": "text", "name": "错误摘要"},
        {"type": "number", "name": "重试次数", "style": {"type": "plain", "precision": 0}},
        {"type": "datetime", "name": "首次失败时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "datetime", "name": "最后失败时间", "style": {"format": "yyyy-MM-dd HH:mm"}},
        {"type": "select", "name": "处理状态", "multiple": false, "options": [{"name": "待重试", "hue": "Orange"}, {"name": "已恢复", "hue": "Green"}, {"name": "需人工", "hue": "Red"}, {"name": "忽略", "hue": "Gray"}]}
      ]
    }
  ]
}
